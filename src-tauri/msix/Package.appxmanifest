<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest. The Store signs the MSIX itself, so the
  package is built unsigned in CI (Release.yml, "Pack MSIX" step).
  Identity values come from Partner Center > Product identity. The Version is
  replaced in CI by the tauri.conf.json version plus ".0" (Store requirement).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="A11yTools.Luma11y"
            Publisher="CN=3AEE39C6-7275-48C3-9BEC-A0B831DC435E"
            Version="0.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Luma11y</DisplayName>
    <PublisherDisplayName>A11y Tools</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="fr-FR" />
    <Resource Language="sk-SK" />
  </Resources>

  <Applications>
    <Application Id="Luma11y" Executable="luma11y.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Luma11y"
        Description="WCAG colour contrast checker with a screen colour picker."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
